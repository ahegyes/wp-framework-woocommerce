{
  "name": "ahegyes/wp-framework-woocommerce",
  "description": "The framework's settings, edit-screen and logging helpers carried onto WooCommerce's own screens and APIs, for plugins that extend WooCommerce.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/ahegyes/wordpress-framework",
  "require": {
    "php": ">=8.5",
    "ahegyes/wp-framework-settings": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "DeepWebSolutions\\Framework\\WooCommerce\\": "src/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-trunk": "2.x-dev"
    },
    "scoping-stubs": [
      "php-stubs/woocommerce-stubs"
    ],
    "scoping-text-domain": "wp-framework",
    "requires-wp": "7.1",
    "requires-plugins": [
      "woocommerce"
    ]
  }
}
